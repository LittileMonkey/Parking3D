{
  "ReverseProxy": {
    "Routes": {
      "auth": {"ClusterId":"identity","Match":{"Path":"/api/v1/auth/{**rest}"}},
      "account": {"ClusterId":"identity","Match":{"Path":"/api/v1/account/{**rest}"}},
      "user-vehicles": {"ClusterId":"identity","Match":{"Path":"/api/v1/user-vehicles/{**rest}"}},
      "membership": {"ClusterId":"identity","Match":{"Path":"/api/v1/membership/{**rest}"}},
      "assignments-sub": {"ClusterId":"identity","Match":{"Path":"/api/v1/staff-assignments/{**rest}"}},
      "assignments": {"ClusterId":"identity","Match":{"Path":"/api/v1/staff-assignments"}},
      "check-in": {"ClusterId":"parking","Order":0,"Match":{"Path":"/api/v1/check-in"}},
      "cash": {"ClusterId":"payment","Order":0,"Match":{"Path":"/api/v1/parking-lots/{lotId}/payments/{paymentId}/cash-confirmation"}},
      "payments": {"ClusterId":"payment","Match":{"Path":"/api/v1/payments/{**rest}"}},
      "forecast": {"ClusterId":"ai","Order":0,"Match":{"Path":"/api/v1/parking-lots/{lotId}/occupancy-forecasts"}},
      "assistant": {"ClusterId":"ai","Order":0,"Match":{"Path":"/api/v1/parking-lots/{lotId}/assistant"}},
      "review": {"ClusterId":"ai","Order":0,"Match":{"Path":"/api/v1/parking-lots/{lotId}/plate-recognitions/{id}/review"}},
      "ai-documents": {"ClusterId":"ai","Match":{"Path":"/api/v1/ai/{**rest}"}},
      "lots": {"ClusterId":"parking","Order":10,"Match":{"Path":"/api/v1/parking-lots/{**rest}"}},
      "bookings": {"ClusterId":"parking","Match":{"Path":"/api/v1/bookings/{**rest}"}}
    },
    "Clusters": {
      "identity":{"Destinations":{"main":{"Address":"http://identity:8080/"}}},
      "parking":{"Destinations":{"main":{"Address":"http://parking:8080/"}}},
      "payment":{"Destinations":{"main":{"Address":"http://payment:8080/"}}},
      "ai":{"Destinations":{"main":{"Address":"http://ai:8080/"}}}
    }
  }
}
