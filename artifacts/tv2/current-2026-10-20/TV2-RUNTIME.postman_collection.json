{
  "info": {
    "name": "TV2 20-10-2026 — acceptance preparation, known blockers",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Use only isolated Development. Collection NOT executed as a suite. Existing TRX and HTTP-EVIDENCE are separate evidence. Configure tokens/fixture locally; request11/12 changes test state. DB idempotency/concurrency require harness; Runner is sequential. Do not use group/production DB."
  },
  "item": [
    {
      "name": "01 Ready — full dependencies required",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/health/ready"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('Standard envelope',()=>{const b=pm.response.json();['result','isSuccess','statusCode','message'].forEach(k=>pm.expect(b).to.have.property(k));pm.expect(b.statusCode).to.eql(pm.response.code);});"
            ]
          }
        }
      ]
    },
