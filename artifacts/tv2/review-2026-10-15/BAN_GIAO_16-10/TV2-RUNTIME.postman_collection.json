    {
      "name": "CREATE CASH",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/payments",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{cashKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bookingId\": \"{{bookingId}}\",\n  \"method\": \"CASH\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Standard envelope', () => { const b=pm.response.json(); ['result','isSuccess','statusCode','message'].forEach(k=>pm.expect(b).to.have.property(k)); pm.expect(b.statusCode).to.eql(pm.response.code); pm.expect(b.isSuccess).to.eql(pm.response.code>=200 && pm.response.code<300); });",
              "if(pm.response.code===200){ const b=pm.response.json(); pm.expect(b.result.id).to.be.a('string'); pm.environment.set('paymentId',b.result.id); }"
            ]
          }
        }
      ]
    },
