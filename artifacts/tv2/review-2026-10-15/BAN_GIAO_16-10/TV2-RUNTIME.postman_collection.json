{
  "info": {
    "name": "TV2 Sprint2 runtime preparation - NOT RUN",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Isolated Development only. Run individual requests after fixing build/Identity contracts. Set bookingId of existing payable fixture; tokens locally. No login URL assumed until Identity/Gateway contract reviewed. HTTP assertions alone do not prove DB idempotency. QR endpoints intentionally omitted pending actual contract."
  },
  "item": [
    {
      "name": "READY",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health/ready",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Standard envelope', () => { const b=pm.response.json(); ['result','isSuccess','statusCode','message'].forEach(k=>pm.expect(b).to.have.property(k)); pm.expect(b.statusCode).to.eql(pm.response.code); pm.expect(b.isSuccess).to.eql(pm.response.code>=200 && pm.response.code<300); });"
            ]
          }
        }
      ]
    },
