# Independent persistent AES-256 key for TOTP secrets (64 hex characters). Never rotate without re-enrollment.
MFA_ENCRYPTION_KEY=

OTP_HMAC_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SENDER=
SMTP_PASSWORD=
