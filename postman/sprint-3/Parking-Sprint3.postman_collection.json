{
  "info": {
    "name": "SCRUM-77 TV2 Sprint 3 — acceptance preparation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Prepared collection, not executed as a suite. Use only isolated synthetic fixtures. Wait for booking CONFIRMED before QR; request 11 can reissue/revoke QR, request12 consumes it. DB assertions and parallel harness are required. No checkout endpoint is invented. Set expectedStatus for a negative case; reset afterward. Never export populated tokens/password/QR."
  },
  "item": [
    {
      "name": "01 Gateway readiness",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/health/ready"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP status matches expectedStatus', () => pm.expect(pm.response.code).to.eql(Number(pm.variables.get('expectedStatus') || 200)));",
              "const payload = pm.response.json();",
              "pm.test('Standard API envelope', () => { for (const key of ['result','isSuccess','statusCode','message']) pm.expect(payload).to.have.property(key); });"
            ]
          }
        }
      ]
    },
    {
