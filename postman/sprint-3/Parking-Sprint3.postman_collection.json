        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP status matches expectedStatus', () => pm.expect(pm.response.code).to.eql(Number(pm.variables.get('expectedStatus') || 200)));",
              "const payload = pm.response.json();",
              "pm.test('Standard API envelope', () => { for (const key of ['result','isSuccess','statusCode','message']) pm.expect(payload).to.have.property(key); });",
              "if (pm.response.code === 200) pm.environment.set('ownerToken', payload.result.accessToken);"
            ]
          }
        }
      ]
    },
